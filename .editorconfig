root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hh,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{csv,ini}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
